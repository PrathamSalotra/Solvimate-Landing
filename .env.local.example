# Supabase configuration (legacy integrations, if enabled)
# URL of your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
# Public/anonymous key for browser-side Supabase access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Private service-role key. Keep this server-side and never expose it publicly.
SUPABASE_SERVICE_ROLE_KEY=

# MongoDB configuration
# MongoDB connection string for the application database.
MONGODB_URI=

# NextAuth configuration
# Long random secret used to sign and encrypt authentication tokens.
NEXTAUTH_SECRET=
# Public URL where the application is running.
NEXTAUTH_URL=
# Authentication provider identifier used by the application.
NEXT_PUBLIC_ADMIN_AUTH_PROVIDER=

# Admin authentication settings
# Authentication mode used by the admin login flow, such as database-backed credentials.
ADMIN_AUTH_MODE=
# Minimum allowed admin password length.
ADMIN_PASSWORD_MIN_LENGTH=
# Number of digits in the one-time password.
ADMIN_OTP_LENGTH=
# OTP validity period in minutes.
ADMIN_OTP_EXPIRY_MINUTES=
# Maximum failed OTP verification attempts.
ADMIN_OTP_MAX_ATTEMPTS=
# Minimum delay between OTP resend requests, in seconds.
ADMIN_OTP_RESEND_COOLDOWN_SECONDS=
# Comma-separated email addresses allowed to be provisioned as admins.
ADMIN_WHITELISTED_EMAILS=

# Resend email configuration
# Resend API key used for outgoing email.
RESEND_API_KEY=
# Verified sender address and display name used in outgoing email.
RESEND_FROM_EMAIL=
# Inbox that receives contact form submissions. The route falls back to RESEND_FROM_EMAIL if omitted.
RESEND_CONTACT_EMAIL=
# Legacy/configuration alias for the contact form recipient, if used by another integration.
CONTACT_TO_EMAIL=
# Inbox that receives HR-related notifications.
HR_TO_EMAIL=
# Comma-separated recipients for vendor notifications.
VENDOR_TO_EMAIL=

# Cloudinary storage configuration
# Cloudinary cloud name.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key.
CLOUDINARY_API_KEY=
# Cloudinary API secret. Keep this server-side.
CLOUDINARY_API_SECRET=
# Cloudinary unsigned upload preset, if client-side unsigned uploads are enabled.
CLOUDINARY_UPLOAD_PRESET=
# Optional complete Cloudinary connection URL.
CLOUDINARY_URL=
